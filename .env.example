# Masti Gurukul backend configuration — PLACEHOLDERS ONLY.
#
# Copy this file to `.env` and paste your own two values from Supabase:
#   Supabase dashboard -> your project -> Project Settings -> API
#
#   SUPABASE_URL        Project URL, starts with https://
#   SUPABASE_ANON_KEY   publishable / anon key (the public one)
#
# NEVER put the service_role or secret key here, and never commit `.env`.
# The anon key is safe to ship inside the app because Row Level Security decides
# what it may read and write. See docs/SUPABASE_SETUP.md.

SUPABASE_URL=https://PASTE-YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here
